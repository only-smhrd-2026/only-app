# 배포용 (docker compose --profile deploy). {$DOMAIN} 은 .env 의 DOMAIN. Let's Encrypt 인증서 자동 (D7).
# 화면(frontend/dist)은 Caddy 가 직접 서빙, /api/* 만 api 컨테이너로 넘김. 단일 오리진이라 CORS 없음.
{$DOMAIN} {
	encode gzip

	# 사진 업로드 배치(장당 10MB × 20장 + 여유)만 크게, 나머지 API 는 5MB (이미지 폭탄 1차 방어)
	@upload path /api/rooms/*/photos
	handle @upload {
		request_body {
			max_size 220MB
		}
		reverse_proxy api:8000
	}

	# 어르신 카메라 사진 1장(서버 UPLOAD_MAX_BYTES 10MB + 여유). 기기 쿠키만 있으면 부르는 주소라 위 220MB 에 넣지 않는다.
	# 이 칸이 없으면 아래 5MB 에 걸려 5~10MB 폰 사진이 서버에 닿기도 전에 413 으로 끊긴다
	@camera path /api/elder/photos
	handle @camera {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8000
	}

	handle /api/* {
		request_body {
			max_size 5MB
		}
		reverse_proxy api:8000
	}

	# SPA: 파일이 없으면 index.html (React Router 가 경로를 처리)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
