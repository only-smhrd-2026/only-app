# 복사해서 .env 로 만드세요:  cp .env.example .env   (Windows PowerShell: Copy-Item .env.example .env)
# 값을 하나도 안 채워도 mock 으로 실행됩니다. 실제 키 값은 .env 에만 적고 단톡방·이슈·PR 에 붙이지 않습니다.

# dev | deploy  (deploy 면 JWT_SECRET 기본값으로는 기동 거부, 쿠키 Secure 켜짐)
APP_ENV=dev

# ---- DB (docker compose 의 db 서비스 기본값과 같음) ----
POSTGRES_USER=only
POSTGRES_PASSWORD=only
POSTGRES_DB=only_app
# 내 PC 에 이미 PostgreSQL 이 떠 있어서 "port is already allocated" 가 나오면 DB_PORT 와 아래 URL 의 포트를 5433 으로
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://only:only@127.0.0.1:5432/only_app

# ---- 가족 로그인 쿠키 서명 키 (32자 이상). 배포 전에 반드시 바꾸기: python -c "import secrets; print(secrets.token_urlsafe(48))" ----
JWT_SECRET=dev-only-jwt-secret-change-me-before-deploy-0000

# ---- AI 부품 제공자. mock 이면 키 없이 고정 답 ----
LLM_PROVIDER=mock
# LLM_PROVIDER=anthropic 일 때만 필요 (홍진성이 11/9 오전 개인 카톡으로 전달)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# mock | rtzr (rtzr 는 아래 RTZR_CLIENT_ID·RTZR_CLIENT_SECRET 과 PC 에 ffmpeg 필요 — 홍진성·배포 서버만. 팀원은 mock 그대로)
STT_PROVIDER=mock
# mock | google (google 은 아래 GOOGLE_TTS_API_KEY 필요 — 홍진성·배포 서버만)
TTS_PROVIDER=mock
# mock | cloudflare (cloudflare 는 아래 CF_ACCOUNT_ID·CF_API_TOKEN 필요 — 홍진성만. 팀원은 mock 그대로)
IMAGE_PROVIDER=mock

# ---- 사진 저장: local(uploads/ 폴더) | r2 ----
STORAGE=local
UPLOAD_DIR=

# ---- 배포(Caddy https). 배포 서버 .env 에만 haruhanjang.duckdns.org (D41). 내 PC 는 비워 둠(localhost) ----
DOMAIN=

# ---- 카카오 로그인 (비워 두면 꺼짐 — 화면에 '준비 중'). 카카오 개발자 콘솔의 REST API 키와 거기 등록한 Redirect URI 를 그대로 ----
# 배포: https://<DOMAIN>/api/auth/kakao/callback · 내 PC: http://localhost:5173/api/auth/kakao/callback (화면 주소로 — 8000 아님)
KAKAO_REST_KEY=
KAKAO_REDIRECT_URI=
# 콘솔에서 'Client Secret' 을 켰을 때만
KAKAO_CLIENT_SECRET=

# ---- 아래는 키를 받으면 채우는 자리 (이름만 예약) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
# 조직 정책으로 서비스계정 JSON 키 생성이 막혀 있어 API 키 사용 (Cloud Text-to-Speech API 하나로만 제한)
GOOGLE_TTS_API_KEY=
CF_ACCOUNT_ID=
CF_API_TOKEN=

# ---- 꼬마심심이 연동 요약 API 의 키 (FR-API-003). 비우면 연동 꺼짐 — /api/integration/summary 가 없는 주소처럼 404 ----
# 기업과 계약을 확정하기 전에는 배포 서버에서도 비워 둔다. 켤 때는 32자 이상 무작위 값으로(짧으면 기동 거부):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTEGRATION_API_KEY=
# 웹 푸시(폰 알림) — 배포 서버만. 비어 있으면 푸시를 보내지 않고 화면의 [알림 켜기]도 숨는다.
# 만들기: backend 폴더에서 uv run python -m scripts.vapid_keys → 나온 세 줄을 여기에. 개인 키는 .env 에만
# VAPID_SUBJECT 는 mailto:운영자 메일 주소 — 아이폰(애플 푸시)은 이 값이 없으면 받지 않는다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
